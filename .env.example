# ---------------------------------------------------------------------
# Little Chef Pizza — environment variables template
# ---------------------------------------------------------------------
# IMPORTANT: This is a plain HTML/CSS/JS site (no build step, no bundler),
# so the browser CANNOT read a .env file — that only works with tools like
# Vite/Next/webpack. The values below are copied by hand into
# js/config.js, which IS committed to git.
#
# This is safe because SUPABASE_ANON_KEY is a public/publishable key,
# designed to be exposed in browser code. Real security comes from
# PostgreSQL Row Level Security (see supabase/policies.sql) — never from
# hiding this key. NEVER put your service_role / secret key anywhere in
# this project.
# ---------------------------------------------------------------------

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
