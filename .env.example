# ---------------------------------------------------------------------
# Little Chef Pizza — environment variables template
# ---------------------------------------------------------------------
# IMPORTANT: This is a plain HTML/CSS/JS site (no build step, no bundler),
# so the browser CANNOT read a .env file — that only works with tools like
# Vite/Next/webpack. The values below are copied by hand into
# js/config.js, which IS committed to git.
#
# This is safe because SUPABASE_ANON_KEY is a public/publishable key,
# designed to be exposed in browser code. Real security comes from
# PostgreSQL Row Level Security (see supabase/policies.sql) — never from
# hiding this key. NEVER put your service_role / secret key anywhere in
# this project.
# ---------------------------------------------------------------------

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here

# ---------------------------------------------------------------------
# SERVER-SIDE ONLY — set these in your Vercel project (Settings →
# Environment Variables). They are read by the serverless functions in
# /api/* and must NEVER appear in js/config.js or any browser code.
# ---------------------------------------------------------------------

# Used by api/_lib/supabase-admin.js (custom OTP signup + order emails).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Used by api/_lib/email-template.js (Nodemailer → Gmail SMTP).
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# Shared secret that authorizes the database trigger to call
# /api/send-order-email (must match the x-webhook-secret value in
# supabase/order_email_notifications_trigger.sql).
EMAIL_WEBHOOK_SECRET=any-long-random-string

# Optional: public site URL, included as a link in the email footer
# (e.g. https://littlechefpizza.vercel.app). Leave unset to omit the link.
SITE_URL=
